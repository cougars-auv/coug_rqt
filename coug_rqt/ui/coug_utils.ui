<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">

  <!--
  @file coug_utils.ui
  @brief UI for the CougUtilsPanel rqt plugin.
  @author Nelson Durrant
  @date June 2026
  -->

  <class>coug_utils</class>
  <widget class="QWidget" name="coug_utils">
    <property name="minimumSize">
      <size>
        <width>160</width>
        <height>242</height>
      </size>
    </property>
    <property name="windowTitle">
      <string>CoUGARs Utils</string>
    </property>
    <layout class="QGridLayout" name="gridLayout">
      <property name="leftMargin">
        <number>6</number>
      </property>
      <property name="topMargin">
        <number>6</number>
      </property>
      <property name="rightMargin">
        <number>6</number>
      </property>
      <property name="bottomMargin">
        <number>6</number>
      </property>
      <property name="verticalSpacing">
        <number>6</number>
      </property>

      <!-- Row 0: Agent Selection -->
      <item row="0" column="0">
        <widget class="QLabel" name="label_agent">
          <property name="text">
            <string>Agent:</string>
          </property>
        </widget>
      </item>
      <item row="0" column="1" colspan="3">
        <widget class="QComboBox" name="agent_selector">
          <property name="sizePolicy">
            <sizepolicy hsizetype="Expanding" vsizetype="Fixed">
              <horstretch>0</horstretch>
              <verstretch>0</verstretch>
            </sizepolicy>
          </property>
          <property name="editable">
            <bool>false</bool>
          </property>
        </widget>
      </item>

      <!-- Row 1: Battery -->
      <item row="1" column="0">
        <widget class="QLabel" name="label_battery">
          <property name="text">
            <string>Battery:</string>
          </property>
        </widget>
      </item>
      <item row="1" column="1" colspan="3">
        <widget class="QLabel" name="battery_status">
          <property name="text">
            <string>Unknown</string>
          </property>
          <property name="wordWrap">
            <bool>true</bool>
          </property>
          <property name="alignment">
            <set>Qt::AlignLeading|Qt::AlignLeft|Qt::AlignVCenter</set>
          </property>
        </widget>
      </item>

      <!-- Row 2: Bag Prefix -->
      <item row="2" column="0">
        <widget class="QLabel" name="label_bag_prefix">
          <property name="text">
            <string>Bag Prefix:</string>
          </property>
        </widget>
      </item>
      <item row="2" column="1" colspan="3">
        <widget class="QLineEdit" name="bag_prefix">
          <property name="sizePolicy">
            <sizepolicy hsizetype="Expanding" vsizetype="Fixed">
              <horstretch>0</horstretch>
              <verstretch>0</verstretch>
            </sizepolicy>
          </property>
          <property name="placeholderText">
            <string>rosbag_prefix</string>
          </property>
        </widget>
      </item>

      <!-- Row 3: Rosbag Record Start / Stop -->
      <item row="3" column="0" alignment="Qt::AlignRight|Qt::AlignVCenter">
        <widget class="QLabel" name="rosbag_indicator">
          <property name="minimumSize">
            <size><width>12</width><height>12</height></size>
          </property>
          <property name="maximumSize">
            <size><width>12</width><height>12</height></size>
          </property>
          <property name="styleSheet">
            <string notr="true">background-color: #cc0000; border-radius: 6px;</string>
          </property>
          <property name="text">
            <string/>
          </property>
        </widget>
      </item>
      <item row="3" column="1" colspan="3">
        <layout class="QHBoxLayout" name="horizontalLayout_rosbag">
          <item>
            <widget class="QPushButton" name="rosbag_start">
              <property name="sizePolicy">
                <sizepolicy hsizetype="Expanding" vsizetype="Fixed">
                  <horstretch>0</horstretch>
                  <verstretch>0</verstretch>
                </sizepolicy>
              </property>
              <property name="text">
                <string>Start Recording</string>
              </property>
            </widget>
          </item>
          <item>
            <widget class="QPushButton" name="rosbag_stop">
              <property name="sizePolicy">
                <sizepolicy hsizetype="Expanding" vsizetype="Fixed">
                  <horstretch>0</horstretch>
                  <verstretch>0</verstretch>
                </sizepolicy>
              </property>
              <property name="text">
                <string>Stop Recording</string>
              </property>
            </widget>
          </item>
        </layout>
      </item>

      <!-- Row 4: Arm / Disarm -->
      <item row="4" column="0" alignment="Qt::AlignRight|Qt::AlignVCenter">
        <widget class="QLabel" name="armed_indicator">
          <property name="minimumSize">
            <size><width>12</width><height>12</height></size>
          </property>
          <property name="maximumSize">
            <size><width>12</width><height>12</height></size>
          </property>
          <property name="styleSheet">
            <string notr="true">background-color: #cc0000; border-radius: 6px;</string>
          </property>
          <property name="text">
            <string/>
          </property>
        </widget>
      </item>
      <item row="4" column="1" colspan="3">
        <layout class="QHBoxLayout" name="horizontalLayout_arm">
          <item>
            <widget class="QPushButton" name="arm_thrusters">
              <property name="sizePolicy">
                <sizepolicy hsizetype="Expanding" vsizetype="Fixed">
                  <horstretch>0</horstretch>
                  <verstretch>0</verstretch>
                </sizepolicy>
              </property>
              <property name="text">
                <string>Arm Thrusters</string>
              </property>
            </widget>
          </item>
          <item>
            <widget class="QPushButton" name="disarm_thrusters">
              <property name="sizePolicy">
                <sizepolicy hsizetype="Expanding" vsizetype="Fixed">
                  <horstretch>0</horstretch>
                  <verstretch>0</verstretch>
                </sizepolicy>
              </property>
              <property name="text">
                <string>Disarm Thrusters</string>
              </property>
            </widget>
          </item>
        </layout>
      </item>

      <!-- Row 5: Enable Acoustics / Disable Acoustics -->
      <item row="5" column="0" alignment="Qt::AlignRight|Qt::AlignVCenter">
        <widget class="QLabel" name="acoustics_indicator">
          <property name="minimumSize">
            <size><width>12</width><height>12</height></size>
          </property>
          <property name="maximumSize">
            <size><width>12</width><height>12</height></size>
          </property>
          <property name="styleSheet">
            <string notr="true">background-color: #cc0000; border-radius: 6px;</string>
          </property>
          <property name="text">
            <string/>
          </property>
        </widget>
      </item>
      <item row="5" column="1" colspan="3">
        <layout class="QHBoxLayout" name="horizontalLayout_acoustics">
          <item>
            <widget class="QPushButton" name="enable_dvl_acoustics">
              <property name="sizePolicy">
                <sizepolicy hsizetype="Expanding" vsizetype="Fixed">
                  <horstretch>0</horstretch>
                  <verstretch>0</verstretch>
                </sizepolicy>
              </property>
              <property name="text">
                <string>Enable DVL Acoustics</string>
              </property>
            </widget>
          </item>
          <item>
            <widget class="QPushButton" name="disable_dvl_acoustics">
              <property name="sizePolicy">
                <sizepolicy hsizetype="Expanding" vsizetype="Fixed">
                  <horstretch>0</horstretch>
                  <verstretch>0</verstretch>
                </sizepolicy>
              </property>
              <property name="text">
                <string>Disable DVL Acoustics</string>
              </property>
            </widget>
          </item>
        </layout>
      </item>

      <!-- Row 6: Separator -->
      <item row="6" column="1" colspan="3">
        <widget class="QFrame" name="separator">
          <property name="frameShape">
            <enum>QFrame::HLine</enum>
          </property>
          <property name="frameShadow">
            <enum>QFrame::Sunken</enum>
          </property>
        </widget>
      </item>

      <!-- Row 7: Emergency Stop / Emergency Surface -->
      <item row="7" column="1" colspan="3">
        <layout class="QHBoxLayout" name="horizontalLayout_emergency">
          <item>
            <widget class="QPushButton" name="emergency_stop">
              <property name="sizePolicy">
                <sizepolicy hsizetype="Expanding" vsizetype="Fixed">
                  <horstretch>0</horstretch>
                  <verstretch>0</verstretch>
                </sizepolicy>
              </property>
              <property name="text">
                <string>Emergency Stop</string>
              </property>
            </widget>
          </item>
          <item>
            <widget class="QPushButton" name="emergency_surface">
              <property name="sizePolicy">
                <sizepolicy hsizetype="Expanding" vsizetype="Fixed">
                  <horstretch>0</horstretch>
                  <verstretch>0</verstretch>
                </sizepolicy>
              </property>
              <property name="text">
                <string>Emergency Surface</string>
              </property>
            </widget>
          </item>
        </layout>
      </item>

      <!-- Row 8: Checkbox -->
      <item row="8" column="1" colspan="3">
        <widget class="QCheckBox" name="apply_all">
          <property name="text">
            <string>Apply to all agents</string>
          </property>
          <property name="checked">
            <bool>false</bool>
          </property>
        </widget>
      </item>

      <!-- Row 9: Status -->
      <item row="9" column="0">
        <widget class="QLabel" name="label_status">
          <property name="text">
            <string>Status:</string>
          </property>
        </widget>
      </item>
      <item row="9" column="1" colspan="3">
        <widget class="QLabel" name="status">
          <property name="styleSheet">
            <string notr="true">color: darkgreen;</string>
          </property>
          <property name="text">
            <string>Ready</string>
          </property>
          <property name="wordWrap">
            <bool>true</bool>
          </property>
          <property name="alignment">
            <set>Qt::AlignLeading|Qt::AlignLeft|Qt::AlignVCenter</set>
          </property>
        </widget>
      </item>

    </layout>
  </widget>

  <resources />
  <connections />
</ui>
