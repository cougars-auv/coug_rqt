<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">

  <!--
  @file coug_utils.ui
  @brief UI for the CougUtilsPanel rqt plugin.
  @author Nelson Durrant
  @date June 2026
  -->

  <class>coug_utils</class>
  <widget class="QWidget" name="coug_utils">
    <property name="minimumSize">
      <size>
        <width>160</width>
        <height>140</height>
      </size>
    </property>
    <property name="windowTitle">
      <string>Coug Utils</string>
    </property>
    <layout class="QGridLayout" name="gridLayout">
      <property name="leftMargin">
        <number>6</number>
      </property>
      <property name="topMargin">
        <number>6</number>
      </property>
      <property name="rightMargin">
        <number>6</number>
      </property>
      <property name="bottomMargin">
        <number>6</number>
      </property>
      <property name="verticalSpacing">
        <number>6</number>
      </property>

      <!-- Row 0: Agent Selection -->
      <item row="0" column="0">
        <widget class="QLabel" name="label_agent">
          <property name="text">
            <string>Agent:</string>
          </property>
        </widget>
      </item>
      <item row="0" column="1" colspan="3">
        <widget class="QComboBox" name="agent_selector">
          <property name="sizePolicy">
            <sizepolicy hsizetype="Expanding" vsizetype="Fixed">
              <horstretch>0</horstretch>
              <verstretch>0</verstretch>
            </sizepolicy>
          </property>
          <property name="editable">
            <bool>false</bool>
          </property>
        </widget>
      </item>

      <!-- Row 1: Arm / Disarm -->
      <item row="1" column="0" alignment="Qt::AlignRight|Qt::AlignVCenter">
        <widget class="QLabel" name="armed_indicator">
          <property name="minimumSize">
            <size><width>12</width><height>12</height></size>
          </property>
          <property name="maximumSize">
            <size><width>12</width><height>12</height></size>
          </property>
          <property name="styleSheet">
            <string notr="true">background-color: #cc0000; border-radius: 6px;</string>
          </property>
          <property name="text">
            <string/>
          </property>
        </widget>
      </item>
      <item row="1" column="1" colspan="3">
        <layout class="QHBoxLayout" name="horizontalLayout_arm">
          <item>
            <widget class="QPushButton" name="arm">
              <property name="sizePolicy">
                <sizepolicy hsizetype="Expanding" vsizetype="Fixed">
                  <horstretch>0</horstretch>
                  <verstretch>0</verstretch>
                </sizepolicy>
              </property>
              <property name="text">
                <string>Arm</string>
              </property>
            </widget>
          </item>
          <item>
            <widget class="QPushButton" name="disarm">
              <property name="sizePolicy">
                <sizepolicy hsizetype="Expanding" vsizetype="Fixed">
                  <horstretch>0</horstretch>
                  <verstretch>0</verstretch>
                </sizepolicy>
              </property>
              <property name="text">
                <string>Disarm</string>
              </property>
            </widget>
          </item>
        </layout>
      </item>

      <!-- Row 2: DVL On / DVL Off -->
      <item row="2" column="0" alignment="Qt::AlignRight|Qt::AlignVCenter">
        <widget class="QLabel" name="dvl_indicator">
          <property name="minimumSize">
            <size><width>12</width><height>12</height></size>
          </property>
          <property name="maximumSize">
            <size><width>12</width><height>12</height></size>
          </property>
          <property name="styleSheet">
            <string notr="true">background-color: #cc0000; border-radius: 6px;</string>
          </property>
          <property name="text">
            <string/>
          </property>
        </widget>
      </item>
      <item row="2" column="1" colspan="3">
        <layout class="QHBoxLayout" name="horizontalLayout_dvl">
          <item>
            <widget class="QPushButton" name="dvl_on">
              <property name="sizePolicy">
                <sizepolicy hsizetype="Expanding" vsizetype="Fixed">
                  <horstretch>0</horstretch>
                  <verstretch>0</verstretch>
                </sizepolicy>
              </property>
              <property name="text">
                <string>DVL On</string>
              </property>
            </widget>
          </item>
          <item>
            <widget class="QPushButton" name="dvl_off">
              <property name="sizePolicy">
                <sizepolicy hsizetype="Expanding" vsizetype="Fixed">
                  <horstretch>0</horstretch>
                  <verstretch>0</verstretch>
                </sizepolicy>
              </property>
              <property name="text">
                <string>DVL Off</string>
              </property>
            </widget>
          </item>
        </layout>
      </item>

      <!-- Row 3: Checkbox -->
      <item row="3" column="1" colspan="3">
        <widget class="QCheckBox" name="apply_all">
          <property name="text">
            <string>Apply to all agents</string>
          </property>
          <property name="checked">
            <bool>false</bool>
          </property>
        </widget>
      </item>

      <!-- Row 4: Status -->
      <item row="4" column="0">
        <widget class="QLabel" name="label_status">
          <property name="text">
            <string>Status:</string>
          </property>
        </widget>
      </item>
      <item row="4" column="1" colspan="3">
        <widget class="QLabel" name="status">
          <property name="styleSheet">
            <string notr="true">color: darkgreen;</string>
          </property>
          <property name="text">
            <string>Ready</string>
          </property>
          <property name="wordWrap">
            <bool>true</bool>
          </property>
          <property name="alignment">
            <set>Qt::AlignLeading|Qt::AlignLeft|Qt::AlignVCenter</set>
          </property>
        </widget>
      </item>

    </layout>
  </widget>

  <resources />
  <connections />
</ui>
